Step 4: Modify your app.py
Add this import near the top (with your other imports):

python
import ollama
Replace the DeepSeek API functions with this Ollama version:

python
def ollama_analyze(texts: dict[str, str], lens_id: str, query: str = "") -> str:
    """Use local Ollama + DeepSeek for free analysis."""
    # Combine texts (limit to save memory)
    combined = "\n\n---\n\n".join([
        f"FILE: {name}\n\n{body[:2000]}"  # Smaller limit for local model
        for name, body in list(texts.items())[:3]  # 3 PDFs max for speed
    ])
    
    lens_label = ANALYSIS_LENSES.get(lens_id, {}).get("label", lens_id)
    
    prompt = f"""You are a research analyst. Analyze these papers.
    
Lens: {lens_label}
{query if query else f"Analyze focusing on: {lens_label}"}

Papers:
{combined}

Give specific insights referencing the texts:"""

    try:
        response = ollama.chat(
            model='deepseek-r1:7b',
            messages=[{'role': 'user', 'content': prompt}]
        )
        return response['message']['content']
    except Exception as e:
        return f"❌ Ollama error: {str(e)}\n\nMake sure Ollama is running (check system tray)"
Remove the old deepseek_client initialization (you don't need OpenAI import or API keys anymore).

Update the sidebar code to use Ollama:

python
with st.sidebar:
    st.subheader("Persona")
    # ... (keep your existing persona code) ...
    
    st.divider()
    st.subheader("🤖 Local DeepSeek (Ollama - FREE)")
    use_ollama = st.checkbox("Enable DeepSeek analysis (runs on your PC)")
    
    if use_ollama:
        try:
            # Test if Ollama is running
            ollama.list()
            st.success("✅ Ollama connected! DeepSeek ready.")
        except:
            st.error("❌ Ollama not running. Open Ollama from Start Menu first.")
        
        analysis_type = st.radio(
            "Analysis type",
            ["Summary & synthesis", "Key claims & evidence", "Research gaps", "Custom query"]
        )
        custom_query = ""
        if analysis_type == "Custom query":
            custom_query = st.text_area("Your question about these PDFs:")
